{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Full permissions for workspace windows: main, window-N, quick-session-UUID, tools-UUID (src-tauri/src/window.rs, ToolsWorkspace.tsx). Secondary windows have their own capability files.",
  "windows": ["main", "window-*", "quick-session-*", "tools-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "window-state:default"
  ]
}
