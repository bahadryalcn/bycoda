{
  "name": "bycoda-desktop",
  "private": true,
  "version": "0.6.64",
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "oxlint . && pnpm run lint:hooks",
    "lint:hooks": "oxlint --config .oxlint-hooks.json src",
    "lint:baseline": "node scripts/checks/check-lint-baseline.mjs",
    "check:colors": "node scripts/checks/check-theme-colors.mjs",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "host:build": "tsc --noEmit -p host/tsconfig.json && node host/build.mjs",
    "host:package": "pnpm run host:build && node host/package.mjs",
    "host": "node build/host/bycoda-host.mjs",
    "pretest:host": "pnpm run host:build",
    "test:host": "vitest run --config host/vitest.config.ts",
    "check": "pnpm run check:web && pnpm run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:types:rust": "tsc-rs --noEmit && tsc-rs --noEmit -p host/tsconfig.json",
    "check:types:rust:fast": "tsc-rs --noEmit --fast && tsc-rs --noEmit --fast -p host/tsconfig.json",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/release/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json",
    "setup:linux:deb": "bash scripts/setup/install-linux-deps-debian.sh",
    "setup:linux:fedora": "bash scripts/setup/install-linux-deps-fedora.sh",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:fedora": "tauri build --bundles rpm",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-windows.ps1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@streamdown/code": "^2.0.0",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "comlink": "^4.4.2",
    "cuelume": "^0.2.4",
    "dompurify": "^3.4.16",
    "es-toolkit": "^1.52.0",
    "franc-min": "^6.2.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "mermaid": "12.1.0",
    "motion": "^14.1.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-joyride": "3.2.0",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "remend": "1.4.0",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "unified": "11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "20.14.6",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react-scan": "^0.5.7",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsc-rs": "0.7.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
