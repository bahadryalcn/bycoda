# Build-time configuration for the optional bycoda account. Copy to `.env.local` for
# reference only: cargo does not read dotenv files, so export the variables in the shell that
# runs `pnpm tauri dev` / `pnpm build`. Vite reads the `VITE_` variable from `.env.local` itself.
#
# With none of these set the account feature is unavailable and the app runs as a guest.
# Values are public (a public PKCE client, endpoints), never secrets. In CI they come from
# GitHub repository variables (Settings > Secrets and variables > Actions > Variables).

# Which set the build uses by default: "production" (default) or "staging".
# BYCODA_ACCOUNT_ENV=production

# Production: OAuth issuer, public client id and account API origin (https, or http on loopback).
# BYCODA_CLERK_ISSUER=https://clerk.example.com
# BYCODA_CLERK_CLIENT_ID=<your-public-oauth-client-id>
# BYCODA_ACCOUNT_API_URL=https://api.example.com

# Staging: the same three with a STAGING prefix.
# BYCODA_STAGING_CLERK_ISSUER=https://clerk.staging.example.com
# BYCODA_STAGING_CLERK_CLIENT_ID=<your-staging-public-oauth-client-id>
# BYCODA_STAGING_ACCOUNT_API_URL=https://api.staging.example.com

# Account web portal (security, data export, delete account links). Frontend build variable;
# the links are hidden when it is unset.
# VITE_BYCODA_ACCOUNT_PORTAL_URL=https://account.example.com
