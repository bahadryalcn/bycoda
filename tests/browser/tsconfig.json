{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "runner.playwright.config.ts",
    "fixture-configs.ts",
    "chat/transcript.playwright.config.ts",
    "../../playwright.config.ts"
  ]
}
